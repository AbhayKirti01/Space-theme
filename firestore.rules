rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: projects
    // Document ID: auto-generated
    // Fields:
    //   - title: string (required)
    //   - description: string (required)
    //   - image: string (required)
    //   - tags: list of strings (required)
    //   - link: string (optional)
    //   - createdAt: timestamp (required)
    //
    // Collection: skills
    // Document ID: auto-generated
    // Fields:
    //   - title: string (required)
    //   - icon: string (required)
    //   - skills: list of strings (required)
    //   - color: string (required)
    //   - image: string (optional)
    //   - order: number (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner() {
      return isAuthenticated() && request.auth.token.email == "abhay.humane3@gmail.com" && request.auth.token.email_verified == true;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidProject(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() < 100 &&
             data.description is string && data.description.size() > 0 && data.description.size() < 500 &&
             data.image is string && data.image.size() > 0 &&
             data.tags is list && data.tags.size() > 0 && data.tags.size() < 10;
    }

    function isValidSkill(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() < 100 &&
             data.icon is string && data.icon.size() > 0 &&
             data.skills is list && data.skills.size() > 0 && data.skills.size() < 20 &&
             data.color is string && data.color.size() > 0 &&
             data.order is number;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /projects/{projectId} {
      allow read: if true;
      allow create, update: if isOwner() && isValidProject(request.resource.data);
      allow delete: if isOwner();
    }

    match /skills/{skillId} {
      allow read: if true;
      allow create, update: if isOwner() && isValidSkill(request.resource.data);
      allow delete: if isOwner();
    }
  }
}
